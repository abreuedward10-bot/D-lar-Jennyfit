    <div class="toast" id="toast">¡Copiado!</div>

    <script>
        // --- REGISTRO DEL SERVICE WORKER PARA QUE SEA INSTALABLE ---
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('sw.js')
                    .then(registration => console.log('SW registrado:', registration.scope))
                    .catch(error => console.log('SW error:', error));
            });
        }

        const API_URL = 'https://allratestoday.com/api/open/central-bank/bcv';
        let tasaUSD = 0;
        let tasaEUR = 0;
        let monedaActual = 'USD'; 

        const foreignInput = document.getElementById('foreign-input');
        const vesInput = document.getElementById('ves-input');
        const statusBadge = document.getElementById('status-badge');
        const currencyName = document.getElementById('currency-name');
        const foreignSymbol = document.getElementById('foreign-symbol');
        const logoUpload = document.getElementById('logo-upload');
        const appLogo = document.getElementById('app-logo');
        const btnRefresh = document.getElementById('btn-refresh');
        const datetimeText = document.getElementById('datetime-text');

        const savedLogo = localStorage.getItem('miAppLogo');
        if (savedLogo) { appLogo.src = savedLogo; }

        logoUpload.addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(event) {
                    appLogo.src = event.target.result;
                    try { localStorage.setItem('miAppLogo', event.target.result); } catch (error) {}
                };
                reader.readAsDataURL(file);
            }
        });

        function updateDateTime() {
            const now = new Date();
            const days = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'];
            const dayName = days[now.getDay()];
            const day = String(now.getDate()).padStart(2, '0');
            const month = String(now.getMonth() + 1).padStart(2, '0');
            const year = String(now.getFullYear()).slice(-2);
            let hours = now.getHours();
            const minutes = String(now.getMinutes()).padStart(2, '0');
            const ampm = hours >= 12 ? 'PM' : 'AM';
            hours = hours % 12;
            hours = hours ? hours : 12;
            datetimeText.textContent = `${dayName}, ${day}/${month}/${year} - ${hours}:${minutes} ${ampm}`;
        }
        updateDateTime();
        setInterval(updateDateTime, 60000);

        function actualizarTasas() {
            btnRefresh.classList.add('rotating');
            fetchRates().finally(() => { setTimeout(() => btnRefresh.classList.remove('rotating'), 500); });
        }

        function toggleCurrency() {
            if (monedaActual === 'USD') {
                monedaActual = 'EUR';
                currencyName.textContent = 'Euro BCV';
                foreignSymbol.textContent = '€';
            } else {
                monedaActual = 'USD';
                currencyName.textContent = 'Dólar BCV';
                foreignSymbol.textContent = '$';
            }
            if (foreignInput.value) convertirMonedaABolivar(foreignInput.value);
        }

        function getActiveRate() { return monedaActual === 'USD' ? tasaUSD : tasaEUR; }

        async function fetchRates() {
            try {
                statusBadge.textContent = 'Consultando tasas oficiales...';
                statusBadge.classList.remove('error');
                const response = await fetch(API_URL);
                if (!response.ok) throw new Error('Error de red');
                const data = await response.json();

                const usdRateObj = data.rates.find(r => r.base === 'USD' && r.quote === 'VES' && r.type === 'sell');
                const eurRateObj = data.rates.find(r => r.base === 'EUR' && r.quote === 'VES' && r.type === 'sell');

                if (!usdRateObj) throw new Error('No se encontró la tasa');

                tasaUSD = usdRateObj.value;
                tasaEUR = eurRateObj ? eurRateObj.value : tasaUSD; 

                let fechaFormateada = data.rate_date;
                if (fechaFormateada && fechaFormateada.includes('-')) {
                    const partes = fechaFormateada.split('-');
                    fechaForma
