<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>JennyFit - Calculadora BCV</title>
    
    <!-- ETIQUETAS PARA CONVERTIRLA EN APP NATIVA (PWA) -->
    <link rel="manifest" href="manifest.json">
    <meta name="theme-color" content="#000000">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <!-- Referencia a tu icono para iOS -->
    <link rel="apple-touch-icon" href="icon-512.png">
    <!-- Icono general -->
    <link rel="icon" type="image/png" href="icon-512.png">

    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;700;800&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <style>
        :root {
            --bg-color: #000000;           
            --card-bg: #121212;            
            --text-main: #ffffff;          
            --text-muted: #888888;         
            --accent-green: #00D32A;       
            --accent-green-rgb: 0, 211, 42; 
            --line-gray: #333333;          
            --btn-refresh-bg: #1A1A1A;     
            --whatsapp-green: #25D366;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Montserrat', sans-serif;
            -webkit-tap-highlight-color: transparent; /* Quita el cuadro azul al tocar en móviles */
        }

        body {
            background-color: var(--bg-color);
            display: flex;
            justify-content: center;
            align-items: flex-start;
            min-height: 100vh;
            padding: 10px;
            color: var(--text-main);
            padding-top: 10px; 
        }

        .app-container {
            width: 100%;
            max-width: 400px;
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        #capture-area {
            background-color: var(--bg-color);
            padding: 5px;
            border-radius: 20px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            width: 100%;
        }

        .app-header {
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            padding: 0;
            margin-top: 10px;
        }

        .app-header img {
            max-height: 110px;
            max-width: 100%;
            object-fit: contain;
            border-radius: 12px; 
        }

        #logo-upload {
            display: none;
        }

        .main-card {
            background-color: var(--card-bg);
            border-radius: 24px;
            padding: 20px;
            border: 1.5px solid rgba(var(--accent-green-rgb), 0.3); 
            box-shadow: 0 10px 30px rgba(0,0,0,0.8);
            width: 100%;
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
        }

        .pill-btn {
            background-color: var(--accent-green);
            color: #ffffff;
            font-weight: 800; 
            font-size: 18px;
            padding: 12px 25px;
            border-radius: 30px;
            border: none;
            outline: none;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(var(--accent-green-rgb), 0.4); 
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .pill-btn .swap-icon {
            font-size: 16px;
            opacity: 0.9;
            font-weight: bold;
        }

        .whatsapp-icon-top {
            color: var(--whatsapp-green);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .status-badge {
            font-size: 11px;
            color: var(--text-muted);
            text-align: center;
            margin-bottom: 20px;
            font-weight: 500;
            height: 15px; 
        }
        .status-badge.error {
            color: #ff5252;
        }

        .input-group {
            display: flex;
            align-items: center;
            border-bottom: 2px solid var(--line-gray);
            padding-bottom: 10px;
            margin-bottom: 20px;
            width: 100%;
        }

        .currency-symbol {
            font-size: 28px;
            font-weight: 700;
            width: 50px;
            flex-shrink: 0;
        }

        .amount-input {
            flex: 1;
            background: transparent;
            border: none;
            color: var(--text-main);
            font-size: 36px; 
            font-weight: 700;
            text-align: right;
            outline: none;
            padding-right: 10px;
            min-width: 0; 
        }

        .amount-input::-webkit-outer-spin-button,
        .amount-input::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }
        .amount-input[type=number] {
            -moz-appearance: textfield;
        }

        .input-group.green .currency-symbol,
        .input-group.green .amount-input {
            color: #ffffff;
        }

        .copy-btn {
            background: transparent;
            border: none;
            color: var(--text-muted);
            font-size: 24px;
            margin-left: 5px;
            cursor: pointer;
            flex-shrink: 0;
        }

        .trend-indicator {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-top: 10px;
            font-size: 15px;
            color: #ffffff;
            font-weight: 600;
        }

        .trend-left {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .bottom-bar {
            display: flex;
            gap: 0;
            width: 100%;
        }

        .date-display {
            flex: 1;
            background-color: var(--card-bg);
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 15px;
            height: 55px;
            font-size: 14px;
            font-weight: 600;
            color: var(--text-main);
            border: 1px solid var(--line-gray);
            white-space: nowrap; 
        }

        .icon-btn {
            background-color: var(--btn-refresh-bg);
            border-radius: 18px;
            width: 55px;
            height: 55px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid var(--line-gray);
            color: #ffffff;
            font-size: 24px;
            cursor: pointer;
            flex-shrink: 0;
        }

        .icon-btn.rotating svg {
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            100% { transform: rotate(360deg); }
        }

        .quick-amounts {
            display: flex;
            gap: 8px;
            padding: 0 5px;
            margin-top: 5px; 
        }

        .quick-btn {
            flex: 1;
            background-color: var(--card-bg);
            border: 1px solid var(--line-gray);
            color: var(--text-main);
            border-radius: 12px;
            padding: 12px 0;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s;
        }

        .quick-btn:active, .quick-btn.active {
            background-color: var(--accent-green);
            color: #ffffff;
            border-color: var(--accent-green);
            box-shadow: 0 0 10px rgba(var(--accent-green-rgb), 0.4);
        }

        .share-btn {
            background-color: var(--whatsapp-green);
            color: #000;
            border: none;
            border-radius: 18px;
            padding: 15px;
            font-size: 16px;
            font-weight: 800;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            cursor: pointer;
            box-shadow: 0 5px 15px rgba(37, 211, 102, 0.3);
            margin-top: 5px;
        }

        .share-btn svg {
            width: 28px;
            height: 28px;
            fill: #000;
        }

        .toast {
            position: fixed;
            bottom: 30px;
            background-color: var(--accent-green);
            color: #ffffff;
            padding: 12px 24px;
            border-radius: 25px;
            font-weight: 800;
            font-size: 14px;
            opacity: 0;
            transition: opacity 0.3s;
            pointer-events: none;
            z-index: 1000;
            box-shadow: 0 5px 15px rgba(var(--accent-green-rgb), 0.4);
        }
        .toast.show { opacity: 1; }

        svg { width: 24px; height: 24px; fill: currentColor; }

        .hide-in-capture {
            display: none !important;
        }
    </style>
</head>
<body>

    <div class="app-container">
        
        <div id="capture-area">
            <label for="logo-upload" class="app-header" title="Toca para cambiar el logo">
                <img src="https://i.ibb.co/6PZgXK5/jennyfit-logo.png" alt="JennyFit Logo" id="app-logo">
                <input type="file" id="logo-upload" accept="image/*">
            </label>

            <div class="main-card">
                <div class="card-header">
                    <button class="pill-btn" id="currency-toggle" onclick="toggleCurrency()">
                        <span id="currency-name">Dólar BCV</span>
